# Copie para `.env` e ajuste. O compose.yaml lê este arquivo automaticamente.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

WEB_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=600
TZ=America/Sao_Paulo

# Coleta
COLLECTOR_INTERVAL_SECONDS=300

# Experimentos (CPU por padrão; com GPU use o overlay compose.gpu.yaml)
EMBEDDING_DEVICE=cpu
EMBEDDING_MODELS=paraphrase-multilingual-MiniLM-L12-v2
LAB_MODEL_UPLOAD_MAX_MB=4096
WORKER_POLL_SECONDS=10
EXPERIMENT_BATCH_SIZE=16
EXPERIMENT_CACHE_ENABLED=0

# Opcional: só necessário para Fase 4/5 com LLM
OPENAI_API_KEY=

LOG_LEVEL=INFO
